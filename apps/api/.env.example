PORT=4000
DATABASE_URL=postgresql://postgres:qdc-sandbox@localhost:5434/wm
JWT_SECRET=change-this-to-a-long-random-secret-of-at-least-32-characters

# PayMongo
PAYMONGO_SECRET_KEY=sk_test_...
PAYMONGO_PUBLIC_KEY=pk_test_...
PAYMONGO_WEBHOOK_SECRET=whsec_...

# SMTP (legacy — used as fallback if multi-provider keys are absent)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@smartaquaph.com

# App
APP_URL=http://localhost:5173

# Multi-provider email fallback (Resend → Brevo → Gmail)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

RUN_MIGRATIONS=false
